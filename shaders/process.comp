#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D inputImage;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

struct HSLAdjustment {
    float h, s, l, w;
};

layout(binding = 2) uniform UniformBuffer {
    float exposure;
    float contrast;
    float highlights;
    float shadows;
    float whites;
    float blacks;
    float saturation;
    float vibrance;
    float hue_offset;
    float temperature;
    float tint;
    float vignette_strength;
    float vignette_feather;
    float vignette_size;
    float grain_amount;
    float grain_size;
    float clarity;
    float denoise_luma;
    float denoise_chroma;
    float sharpen_intensity;
    float base_exposure;
    float contrast_pivot;
    float blacks_scale;
    float whites_scale;
    int hsl_enabled;
    HSLAdjustment hsl_adjustments[15];
    int show_clipping_indicator;
} u;

layout(binding = 3) uniform sampler2D grainTexture;

// --- Helpers ---

vec3 sRGB_to_linear(vec3 c) {
    return pow(max(c, vec3(0.0)), vec3(2.2));
}

vec3 linear_to_sRGB(vec3 c) {
    return pow(max(c, vec3(0.0)), vec3(1.0/2.2));
}

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 rgb2ycbcr(vec3 c) {
    float y = 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
    float cb = (c.b - y) / 1.8556;
    float cr = (c.r - y) / 1.5748;
    return vec3(y, cb, cr);
}

vec3 ycbcr2rgb(vec3 c) {
    float y = c.x;
    float cb = c.y;
    float cr = c.z;
    float r = y + 1.5748 * cr;
    float g = y - 0.1873 * cb - 0.4681 * cr;
    float b = y + 1.8556 * cb;
    return vec3(r, g, b);
}

vec3 rotate_hue_rgb(vec3 rgb, float angle) {
    float theta = angle * 6.28318530718;
    vec3 axis = normalize(vec3(1.0, 1.0, 1.0));
    float cosA = cos(theta);
    float sinA = sin(theta);
    float oneMinusCos = 1.0 - cosA;
    float dotProduct = dot(axis, rgb);
    vec3 crossProd = cross(axis, rgb);
    return rgb * cosA + crossProd * sinA + axis * dotProduct * oneMinusCos;
}

float gaussian_weight(float distance, float sigma) {
    return exp(-(distance * distance) / (2.0 * sigma * sigma));
}

vec3 denoise_bilateral(sampler2D tex, vec2 uv, float sigma_s, float sigma_r) {
    if (sigma_s < 0.1 || sigma_r < 0.001) return texture(tex, uv).rgb;

    vec2 tex_size = vec2(textureSize(tex, 0));
    vec2 pixel_size = 1.0 / tex_size;
    
    vec3 center_color = texture(tex, uv).rgb;
    vec3 sum_color = vec3(0.0);
    float sum_weight = 0.0;
    
    int radius = int(ceil(2.0 * sigma_s));
    radius = clamp(radius, 1, 2); 
    
    for (int x = -radius; x <= radius; x++) {
        for (int y = -radius; y <= radius; y++) {
            vec2 offset = vec2(float(x), float(y)) * pixel_size;
            vec3 sample_color = texture(tex, uv + offset).rgb;
            
            float dist2 = float(x*x + y*y);
            float spatial_weight = exp(-dist2 / (2.0 * sigma_s * sigma_s));
            
            vec3 diff = sample_color - center_color;
            float intensity_diff2 = dot(diff, diff);
            float range_weight = exp(-intensity_diff2 / (2.0 * sigma_r * sigma_r));
            
            float weight = spatial_weight * range_weight;
            
            sum_color += sample_color * weight;
            sum_weight += weight;
        }
    }
    
    return sum_color / (sum_weight + 0.0001);
}

vec3 denoise_chroma_sparse(sampler2D tex, vec2 uv, float sigma_s, float sigma_r) {
    if (sigma_s < 0.1 || sigma_r < 0.001) return texture(tex, uv).rgb;

    vec2 tex_size = vec2(textureSize(tex, 0));
    vec2 pixel_size = 1.0 / tex_size;
    float stride = max(1.0, sigma_s / 2.0);
    
    vec3 center_color = texture(tex, uv).rgb;
    vec3 sum_color = vec3(0.0);
    float sum_weight = 0.0;
    
    for (int x = -2; x <= 2; x++) {
        for (int y = -2; y <= 2; y++) {
            vec2 offset = vec2(float(x), float(y)) * stride * pixel_size;
            vec3 sample_color = texture(tex, uv + offset).rgb;
            
            float dist2 = dot(vec2(float(x), float(y)) * stride, vec2(float(x), float(y)) * stride);
            float spatial_weight = exp(-dist2 / (2.0 * sigma_s * sigma_s));
            
            vec3 diff = sample_color - center_color;
            float intensity_diff2 = dot(diff, diff);
            float range_weight = exp(-intensity_diff2 / (2.0 * sigma_r * sigma_r));
            
            float weight = spatial_weight * range_weight;
            
            sum_color += sample_color * weight;
            sum_weight += weight;
        }
    }
    
    return sum_color / (sum_weight + 0.0001);
}

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (texelCoord.x >= size.x || texelCoord.y >= size.y) return;

    vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size);
    vec4 color = texture(inputImage, uv);

    // 0. Denoise
    if (u.denoise_luma > 0.001 || u.denoise_chroma > 0.001) {
        vec3 ycbcr = rgb2ycbcr(color.rgb);
        if (u.denoise_luma > 0.001) {
            float sigma_s = 1.0 + u.denoise_luma * 5.0;
            float sigma_r = 0.001 + u.denoise_luma * 0.05;
            vec3 denoised_rgb = denoise_bilateral(inputImage, uv, sigma_s, sigma_r);
            ycbcr.x = rgb2ycbcr(denoised_rgb).x;
        }
        if (u.denoise_chroma > 0.001) {
            float sigma_s = 2.0 + u.denoise_chroma * 20.0;
            float sigma_r = 0.01 + u.denoise_chroma * 0.2;
            vec3 denoised_rgb = denoise_chroma_sparse(inputImage, uv, sigma_s, sigma_r);
            vec3 denoised_ycbcr = rgb2ycbcr(denoised_rgb);
            ycbcr.yz = denoised_ycbcr.yz;
        }
        color.rgb = clamp(ycbcr2rgb(ycbcr), 0.0, 1.0);
    }

    // 0.5 Sharpening (Laplacian)
    if (u.sharpen_intensity > 0.001) {
        float maxDim = max(float(size.x), float(size.y));
        float lodOffset = log2(maxDim / 4000.0);
        float mipLod = max(0.0, 0.7 + lodOffset);
        
        vec2 pixelSize = 1.0 / vec2(size);
        vec3 g_i = textureLod(inputImage, uv, mipLod).rgb;
        vec3 g_i1 = textureLod(inputImage, uv, mipLod + 1.0).rgb;
        vec3 laplacian = g_i - g_i1;
        
        float sampleOffset = pow(2.0, mipLod);
        vec3 left = textureLod(inputImage, uv + vec2(-sampleOffset, 0.0) * pixelSize, mipLod).rgb;
        vec3 right = textureLod(inputImage, uv + vec2(sampleOffset, 0.0) * pixelSize, mipLod).rgb;
        vec3 up = textureLod(inputImage, uv + vec2(0.0, -sampleOffset) * pixelSize, mipLod).rgb;
        vec3 down = textureLod(inputImage, uv + vec2(0.0, sampleOffset) * pixelSize, mipLod).rgb;
        
        float edgeStrength = length(right - left) + length(down - up);
        float edgeMask = 1.0 / (1.0 + edgeStrength / 0.05);
        float lumaVal = dot(g_i, vec3(0.2126, 0.7152, 0.0722));
        float lumaProtect = smoothstep(0.0, 0.05, lumaVal) * smoothstep(1.0, 0.9, lumaVal);
        
        color.rgb += laplacian * edgeMask * lumaProtect * u.sharpen_intensity * 4.0;
        color.rgb = max(color.rgb, vec3(0.0));
    }

    // 1. White Balance
    vec3 wb_gains = vec3(1.0);
    wb_gains.r += u.temperature * 0.5;
    wb_gains.b -= u.temperature * 0.5;
    wb_gains.g -= u.tint * 0.5;
    color.rgb *= wb_gains;

    // 2. Exposure
    color.rgb *= pow(2.0, u.exposure + u.base_exposure);

    // 2.5 Clarity
    if (abs(u.clarity) > 0.001) {
        float maxDim = max(float(size.x), float(size.y));
        float lodOffset = log2(maxDim / 4000.0);
        float clarityLod = max(0.0, 4.0 + lodOffset);
        vec3 blurred = textureLod(inputImage, uv, clarityLod).rgb;
        float blurredLuma = dot(blurred, vec3(0.2126, 0.7152, 0.0722));
        float currentLuma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        
        float ratio = currentLuma / (blurredLuma + 0.0001);
        float enhancedLuma = blurredLuma * pow(ratio, 1.0 + u.clarity * 0.5);
        color.rgb *= (enhancedLuma / (currentLuma + 0.0001));
    }

    // 3. Lighting & Color
    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    
    // Vibrance
    float max_comp = max(color.r, max(color.g, color.b));
    float min_comp = min(color.r, min(color.g, color.b));
    float sat = (max_comp - min_comp) / (max_comp + 0.0001);
    float vibrance_factor = 1.0 + u.vibrance * (1.0 - sat);
    color.rgb = mix(vec3(luma), color.rgb, vibrance_factor);

    // Saturation
    luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    color.rgb = mix(vec3(luma), color.rgb, u.saturation);

    // HSL Adjustments
    if (u.hsl_enabled != 0) {
        vec3 hsv = rgb2hsv(color.rgb);
        vec4 total_adj = vec4(0.0);
        float total_weight = 0.0;
        for (int i = 0; i < 15; i++) {
            float slice_hue = float(i) / 15.0;
            float distH = abs(hsv.x - slice_hue);
            if (distH > 0.5) distH = 1.0 - distH;
            float w = gaussian_weight(distH, 0.028) * smoothstep(0.0, 0.2, hsv.y);
            total_adj += vec4(u.hsl_adjustments[i].h, u.hsl_adjustments[i].s, u.hsl_adjustments[i].l, 0.0) * w;
            total_weight += w;
        }
        if (total_weight > 0.001) {
            vec3 adj = total_adj.xyz / total_weight;
            if (abs(adj.x) > 0.001) color.rgb = rotate_hue_rgb(color.rgb, adj.x);
            hsv = rgb2hsv(color.rgb);
            hsv.y = clamp(hsv.y + adj.y, 0.0, 1.0);
            hsv.z = max(0.0, hsv.z + adj.z);
            color.rgb = hsv2rgb(hsv);
        }
    }

    // Global Hue Offset
    if (abs(u.hue_offset) > 0.001) color.rgb = rotate_hue_rgb(color.rgb, u.hue_offset);

    // Contrast
    color.rgb = (color.rgb - u.contrast_pivot) * u.contrast + u.contrast_pivot;

    // Tonal Controls (Gaussian)
    luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    float percLuma = pow(clamp(luma, 0.0, 1.0), 1.0/2.2);
    float invTwoSigmaSq = 24.85;
    float blacksWeight = exp(-pow(percLuma - 0.0, 2.0) * invTwoSigmaSq);
    float shadowsWeight = exp(-pow(percLuma - 0.333, 2.0) * invTwoSigmaSq);
    float highlightsWeight = exp(-pow(percLuma - 0.667, 2.0) * invTwoSigmaSq);
    float whitesWeight = exp(-pow(percLuma - 1.0, 2.0) * invTwoSigmaSq);
    
    color.rgb += (u.blacks * 0.12 * blacksWeight + u.shadows * 0.12 * shadowsWeight + 
                  u.highlights * 0.12 * highlightsWeight + u.whites * 0.12 * whitesWeight);

    // 4. Effects
    // Vignette
    vec2 uv_centered = uv - 0.5;
    float aspect = float(size.x) / float(size.y);
    uv_centered.x *= aspect;
    float dist = length(uv_centered);
    float radius = u.vignette_size * 0.8;
    float feather = u.vignette_feather * 0.5 + 0.01;
    float vignette = 1.0 - smoothstep(radius, radius + feather, dist);
    color.rgb *= mix(1.0, vignette, u.vignette_strength);

    // Grain
    if (u.grain_amount > 0.001) {
        vec2 grainUV = uv * u.grain_size;
        vec4 grainData = texture(grainTexture, grainUV);
        float grain = (grainData.r + grainData.g + grainData.b) / 3.0;
        grain = (grain - 0.5) * 2.0;
        color.rgb += grain * u.grain_amount * 0.1;
    }

    // 5. Tone Mapping & Clipping
    color.rgb = clamp(color.rgb, 0.0, 1.0);
    color.rgb = linear_to_sRGB(color.rgb);

    if (u.show_clipping_indicator != 0) {
        float l = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        if (l >= 0.98 && color.r >= 0.98 && color.g >= 0.98 && color.b >= 0.98) color.rgb = mix(color.rgb, vec3(1.0, 0.0, 0.0), 0.5);
        else if (l <= 0.02 && color.r <= 0.02 && color.g <= 0.02 && color.b <= 0.02) color.rgb = mix(color.rgb, vec3(0.0, 1.0, 0.0), 0.5);
    }

    imageStore(outputImage, texelCoord, vec4(color.rgb, 1.0));
}
